@model List<Order>
@{
    ViewData["Title"] = "Siparişlerim";
}

<div class="container">
    <div class="page-head">
        <h1 class="page-title">Siparişlerim</h1>
    </div>

    <div class="row g-4">
        <aside class="col-lg-3">
            <partial name="_AccountMenu" />
        </aside>

        <section class="col-lg-9">
            @if (Model.Count == 0)
            {
                <div class="empty-state">
                    <div class="empty-icon"><i class="bi bi-box-seam"></i></div>
                    <h2>Henüz siparişiniz yok</h2>
                    <p>Verdiğiniz siparişler ve durumları burada listelenir.</p>
                    <a class="btn btn-primary" asp-controller="Shop" asp-action="List" asp-route-category="">Alışverişe Başla</a>
                </div>
            }

            @foreach (var order in Model)
            {
                <div class="surface order-card">
                    <div class="order-head">
                        <div><small>Sipariş No</small><strong>@order.OrderNumber</strong></div>
                        <div><small>Tarih</small><strong>@order.CreatedDate.ToTrDateTime()</strong></div>
                        <div><small>Ödeme</small><strong>@order.PaymentType.DisplayName</strong></div>
                        <div><small>Tutar</small><strong>@order.TotalPrice.ToTL()</strong></div>
                        <div class="ms-auto"><span class="status @order.State.BadgeClass">@order.State.DisplayName</span></div>
                    </div>

                    <div class="order-body">
                        <div class="row g-4">
                            <div class="col-md-8">
                                @foreach (var item in order.Items)
                                {
                                    <div class="order-line">
                                        <img class="thumb thumb--sm" src="@(item.Product?.CoverImage ?? ProductExtensions.Placeholder)" alt="" />
                                        <div class="flex-grow-1">
                                            <a class="cart-name" asp-controller="Shop" asp-action="Details" asp-route-id="@item.ProductId">@item.ProductName</a>
                                            <div class="small text-muted">@item.Quantity × @item.Price.ToTL()</div>
                                        </div>
                                        <strong class="text-dark">@((item.Price * item.Quantity).ToTL())</strong>
                                    </div>
                                }
                            </div>
                            <div class="col-md-4 small">
                                <div class="text-muted text-uppercase fw-bold mb-2" style="font-size: .7rem; letter-spacing: .06em">Teslimat adresi</div>
                                <div class="fw-semibold text-dark">@order.FullName</div>
                                <div>@order.Address</div>
                                <div>@order.City</div>
                                <div class="text-muted mt-1">@order.Phone</div>
                            </div>
                        </div>

                        @if (order.State == OrderState.PaymentPending)
                        {
                            <div class="alert alert-warning small mt-3 mb-0">
                                <i class="bi bi-hourglass-split me-1"></i>
                                Havale/EFT ödemeniz bekleniyor. IBAN: <span class="font-monospace">TR00 0000 0000 0000 0000 0000 00</span>
                                · Açıklamaya <strong>@order.OrderNumber</strong> yazın.
                            </div>
                        }
                    </div>
                </div>
            }
        </section>
    </div>
</div>
