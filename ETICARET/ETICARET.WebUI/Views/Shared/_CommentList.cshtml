@model CommentListViewModel
@* Hem ürün detay sayfasında hem de AJAX ile (CommentController.List) kullanılır.
   Butonlar data-action ile işaretlidir; tıklamaları wwwroot/js/comments.js yakalar. *@
@{
    var userId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var isAdmin = User.IsInRole(Roles.Admin);
}

<div data-comment-count="@Model.Comments.Count">
    @if (User.Identity?.IsAuthenticated == true)
    {
        <form id="comment-form" class="comment-form">
            <div class="avatar">@(User.Identity.Name![..1].ToUpper())</div>
            <div class="flex-grow-1">
                <textarea name="text" class="form-control" maxlength="1000" placeholder="Bu ürün hakkındaki düşüncelerinizi paylaşın..."></textarea>
                <div class="text-end mt-2">
                    <button class="btn btn-primary btn-sm" type="submit"><i class="bi bi-send"></i> Yorum Yap</button>
                </div>
            </div>
        </form>
    }
    else
    {
        <div class="alert alert-light border mb-4">
            Yorum yapmak için
            <a asp-controller="Account" asp-action="Login"
               asp-route-returnUrl="@Url.Action("Details", "Shop", new { id = Model.ProductId })">giriş yapın</a>.
        </div>
    }

    @if (Model.Comments.Count == 0)
    {
        <p class="text-muted mb-0">Henüz yorum yapılmamış. İlk yorumu siz yazın!</p>
    }

    @foreach (var comment in Model.Comments)
    {
        var isOwner = comment.UserId == userId;

        <div class="comment-item" data-comment-id="@comment.Id">
            <div class="avatar">@(comment.UserName[..1].ToUpper())</div>
            <div class="flex-grow-1">
                <div class="comment-meta">
                    <span class="comment-author">@comment.UserName</span>
                    <span class="comment-date">@comment.CreatedDate.ToTrDateTime()</span>
                </div>
                <p class="comment-text">@comment.Text</p>

                @if (isOwner || isAdmin)
                {
                    <div class="comment-actions">
                        @if (isOwner)
                        {
                            <button type="button" data-action="edit"><i class="bi bi-pencil"></i> Düzenle</button>
                        }
                        <button type="button" class="text-danger-hover" data-action="delete"><i class="bi bi-trash"></i> Sil</button>
                    </div>
                }

                @if (isOwner)
                {
                    <div class="comment-edit">
                        <textarea class="form-control mb-2" maxlength="1000">@comment.Text</textarea>
                        <button type="button" class="btn btn-primary btn-sm" data-action="save">Kaydet</button>
                        <button type="button" class="btn btn-light btn-sm" data-action="cancel">Vazgeç</button>
                    </div>
                }
            </div>
        </div>
    }
</div>
