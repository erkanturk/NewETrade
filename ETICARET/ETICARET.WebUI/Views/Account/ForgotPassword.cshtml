@model ForgotPasswordModel
@{
    ViewData["Title"] = "Şifremi Unuttum";
}

<div class="auth-wrap">
    <div class="auth-card">
        <div class="brand-mark"><i class="bi bi-key-fill"></i></div>
        <h1>Şifrenizi mi unuttunuz?</h1>
        <p class="lead-text">E-posta adresinizi yazın, size şifre sıfırlama bağlantısı gönderelim.</p>

        <form asp-action="ForgotPassword" method="post">
            <div class="mb-4">
                <label asp-for="Email" class="form-label"></label>
                <div class="input-icon">
                    <i class="bi bi-envelope"></i>
                    <input asp-for="Email" class="form-control" placeholder="ornek@eposta.com" autocomplete="email" autofocus />
                </div>
                <span asp-validation-for="Email"></span>
            </div>
            <button class="btn btn-primary btn-lg w-100" type="submit">Bağlantı Gönder</button>
        </form>

        <div class="auth-footer">
            <a asp-action="Login"><i class="bi bi-arrow-left"></i> Giriş sayfasına dön</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
