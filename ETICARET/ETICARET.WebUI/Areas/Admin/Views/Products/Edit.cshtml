@model ProductFormModel
@{
    ViewData["Title"] = "Ürünü Düzenle";
}

<div class="admin-page-head">
    <div>
        <h1>Ürünü Düzenle</h1>
        <p>#@Model.Id · @Model.Name</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-light" asp-area="" asp-controller="Shop" asp-action="Details" asp-route-id="@Model.Id" target="_blank"><i class="bi bi-eye me-1"></i> Mağazada gör</a>
        <a class="btn btn-light" asp-action="Index"><i class="bi bi-arrow-left me-1"></i> Ürünler</a>
    </div>
</div>

<partial name="_ProductForm" model="Model" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
