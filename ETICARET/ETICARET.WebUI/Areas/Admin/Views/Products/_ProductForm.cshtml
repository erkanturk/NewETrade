@model ProductFormModel
@* Ekleme ve düzenleme aynı formu kullanır (Partial View). Id == 0 → yeni ürün.
   enctype="multipart/form-data" → dosya yüklemek için ŞART. *@

<form asp-action="@(Model.Id == 0 ? "Create" : "Edit")" method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly"></div>

    <div class="row g-4">
        <div class="col-xl-8">
            <div class="panel mb-4">
                <div class="panel-head"><h2>Ürün Bilgileri</h2></div>
                <div class="panel-body">
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="6"></textarea>
                        <div class="form-text">Her satır, ürün sayfasında ayrı bir satır olarak görünür.</div>
                        <span asp-validation-for="Description"></span>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="Price" class="form-label"></label>
                            <div class="input-group">
                                <span class="input-group-text">₺</span>
                                <input asp-for="Price" type="number" step="0.01" min="0" class="form-control" />
                            </div>
                            <span asp-validation-for="Price"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Stock" class="form-label"></label>
                            <input asp-for="Stock" type="number" min="0" class="form-control" />
                            <span asp-validation-for="Stock"></span>
                        </div>
                    </div>
                    <div class="form-check form-switch mt-4">
                        <input asp-for="IsHome" class="form-check-input" role="switch" />
                        <label asp-for="IsHome" class="form-check-label"></label>
                    </div>
                </div>
            </div>

            <div class="panel">
                <div class="panel-head"><h2>Kategoriler</h2></div>
                <div class="panel-body">
                    <div class="check-grid">
                        @foreach (var category in Model.AllCategories)
                        {
                            <div class="check-tile">
                                <input type="checkbox" name="CategoryIds" value="@category.Id" id="category-@category.Id"
                                       checked="@Model.CategoryIds.Contains(category.Id)" />
                                <label for="category-@category.Id">@category.Name</label>
                            </div>
                        }
                    </div>
                    <span asp-validation-for="CategoryIds"></span>
                </div>
            </div>
        </div>

        <div class="col-xl-4">
            <div class="panel">
                <div class="panel-head"><h2>Resimler</h2></div>
                <div class="panel-body">
                    @if (Model.ExistingImages.Count > 0)
                    {
                        <p class="small text-muted mb-2">Kaldırmak istediğiniz resimleri işaretleyin.</p>
                        <div class="image-grid mb-3">
                            @foreach (var image in Model.ExistingImages)
                            {
                                <label class="image-tile" title="Kaldır">
                                    <img src="@image.Src" alt="" />
                                    <input class="form-check-input remove" type="checkbox" name="DeleteImageIds" value="@image.Id" />
                                </label>
                            }
                        </div>
                    }

                    <label class="upload-box" for="Files">
                        <i class="bi bi-cloud-arrow-up"></i>
                        <div class="fw-semibold mt-2">Resim seçin</div>
                        <div class="small text-muted">JPG, PNG veya WEBP · en fazla 5 MB</div>
                    </label>
                    <input asp-for="Files" type="file" class="d-none" multiple accept=".jpg,.jpeg,.png,.webp" data-preview="#new-images" />
                    <span asp-validation-for="Files"></span>
                    <div id="new-images" class="image-grid mt-3"></div>
                </div>
            </div>

            <div class="d-grid gap-2 mt-4">
                <button class="btn btn-primary btn-lg" type="submit"><i class="bi bi-check2 me-1"></i> Kaydet</button>
                <a class="btn btn-light" asp-action="Index">Vazgeç</a>
            </div>
        </div>
    </div>
</form>
