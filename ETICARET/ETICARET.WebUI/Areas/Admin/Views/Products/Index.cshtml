@model List<Product>
@{
    ViewData["Title"] = "Ürünler";
}

<div class="admin-page-head">
    <div>
        <h1>Ürünler</h1>
        <p>@Model.Count ürün listeleniyor</p>
    </div>
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg me-1"></i> Yeni Ürün</a>
</div>

<div class="panel">
    <div class="table-responsive">
        <table class="table table-admin">
            <thead>
                <tr>
                    <th style="width: 72px"></th>
                    <th>Ürün</th>
                    <th>Kategori</th>
                    <th class="text-end">Fiyat</th>
                    <th class="text-center">Stok</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in Model)
                {
                    <tr>
                        <td><img class="table-thumb" src="@product.CoverImage" alt="" loading="lazy" /></td>
                        <td>
                            <div class="fw-semibold text-dark">@product.Name</div>
                            <div class="small text-muted">
                                #@product.Id
                                @if (product.IsHome)
                                {
                                    <span class="ms-2 text-primary"><i class="bi bi-star-fill"></i> Ana sayfada</span>
                                }
                            </div>
                        </td>
                        <td>
                            @foreach (var category in product.Categories)
                            {
                                <span class="tag">@category.Name</span>
                            }
                        </td>
                        <td class="text-end fw-bold text-dark text-nowrap">@product.Price.ToTL()</td>
                        <td class="text-center">
                            <span class="stock-badge @(product.Stock == 0 ? "is-out" : product.Stock <= 5 ? "is-low" : "")">@product.Stock</span>
                        </td>
                        <td>
                            <div class="table-actions">
                                <a class="btn btn-sm btn-light" asp-area="" asp-controller="Shop" asp-action="Details" asp-route-id="@product.Id" target="_blank" title="Mağazada gör"><i class="bi bi-eye"></i></a>
                                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@product.Id"><i class="bi bi-pencil"></i> Düzenle</a>
                                <form asp-action="Delete" asp-route-id="@product.Id" method="post" data-confirm="&quot;@product.Name&quot; silinsin mi?">
                                    <button class="btn btn-sm btn-light text-danger" type="submit" title="Sil"><i class="bi bi-trash3"></i></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
