@model List<UserListItem>
@{
    ViewData["Title"] = "Kullanıcılar";
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
}

<div class="admin-page-head">
    <div>
        <h1>Kullanıcılar</h1>
        <p>@Model.Count kayıtlı kullanıcı</p>
    </div>
</div>

<div class="panel">
    <div class="table-responsive">
        <table class="table table-admin">
            <thead>
                <tr>
                    <th>Kullanıcı</th>
                    <th>E-posta</th>
                    <th>Rol</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    var isMe = user.Id == currentUserId;
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-3">
                                <div class="avatar">@(user.UserName.Length > 0 ? user.UserName[..1].ToUpper() : "?")</div>
                                <div>
                                    <div class="fw-semibold text-dark">
                                        @user.UserName
                                        @if (isMe) { <span class="badge text-bg-light ms-1">Siz</span> }
                                    </div>
                                    <div class="small text-muted">@user.FullName</div>
                                </div>
                            </div>
                        </td>
                        <td>
                            <div>@user.Email</div>
                            @if (user.EmailConfirmed)
                            {
                                <span class="small text-success"><i class="bi bi-patch-check-fill"></i> Onaylı</span>
                            }
                            else
                            {
                                <span class="small text-warning"><i class="bi bi-hourglass-split"></i> Onay bekliyor</span>
                            }
                        </td>
                        <td>
                            @if (user.IsAdmin)
                            {
                                <span class="status status-primary">Yönetici</span>
                            }
                            else
                            {
                                <span class="status status-muted">Müşteri</span>
                            }
                        </td>
                        <td>
                            <div class="table-actions">
                                @* E-posta onayı sadece kullanıcıya giden maildeki linkle yapılır (AccountController.ConfirmEmail) *@
                                @if (!isMe)
                                {
                                    <form asp-action="ToggleAdmin" asp-route-id="@user.Id" method="post">
                                        <button class="btn btn-sm btn-outline-primary" type="submit">
                                            @(user.IsAdmin ? "Yöneticilikten çıkar" : "Yönetici yap")
                                        </button>
                                    </form>
                                    <form asp-action="Delete" asp-route-id="@user.Id" method="post" data-confirm="@user.UserName kullanıcısı silinsin mi?">
                                        <button class="btn btn-sm btn-light text-danger" type="submit" title="Sil"><i class="bi bi-trash3"></i></button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
