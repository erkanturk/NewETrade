@model List<Order>
@{
    ViewData["Title"] = "Siparişler";
}

<div class="admin-page-head">
    <div>
        <h1>Siparişler</h1>
        <p>@Model.Count sipariş</p>
    </div>
</div>

<div class="panel">
    @if (Model.Count == 0)
    {
        <div class="panel-body text-muted">Henüz sipariş verilmedi.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-admin">
                <thead>
                    <tr>
                        <th>Sipariş No</th>
                        <th>Müşteri</th>
                        <th>Tarih</th>
                        <th>Ödeme</th>
                        <th>Durum</th>
                        <th class="text-end">Tutar</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td class="fw-semibold font-monospace">@order.OrderNumber</td>
                            <td>
                                <div class="fw-semibold text-dark">@order.FullName</div>
                                <div class="small text-muted">@order.Email</div>
                            </td>
                            <td class="text-muted text-nowrap">@order.CreatedDate.ToString("dd.MM.yyyy HH:mm")</td>
                            <td>@order.PaymentType.DisplayName</td>
                            <td><span class="status @order.State.BadgeClass">@order.State.DisplayName</span></td>
                            <td class="text-end fw-bold text-dark text-nowrap">@order.TotalPrice.ToTL()</td>
                            <td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@order.Id">Detay</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
