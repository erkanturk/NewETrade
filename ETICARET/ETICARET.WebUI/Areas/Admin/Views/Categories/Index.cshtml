@model List<CategoryWithCount>
@{
    ViewData["Title"] = "Kategoriler";
}

<div class="admin-page-head">
    <div>
        <h1>Kategoriler</h1>
        <p>@Model.Count kategori</p>
    </div>
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg me-1"></i> Yeni Kategori</a>
</div>

<div class="panel">
    <div class="table-responsive">
        <table class="table table-admin">
            <thead>
                <tr>
                    <th style="width: 72px"></th>
                    <th>Kategori</th>
                    <th class="text-center">Ürün sayısı</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var category in Model)
                {
                    <tr>
                        <td><img class="table-thumb" src="@ProductExtensions.ImagePath(category.ImageUrl)" alt="" /></td>
                        <td class="fw-semibold text-dark">@category.Name</td>
                        <td class="text-center">@category.ProductCount</td>
                        <td>
                            <div class="table-actions">
                                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@category.Id"><i class="bi bi-pencil"></i> Düzenle</a>
                                <form asp-action="Delete" asp-route-id="@category.Id" method="post"
                                      data-confirm="&quot;@category.Name&quot; silinsin mi? Ürünler silinmez, sadece bu kategoriden çıkarılır.">
                                    <button class="btn btn-sm btn-light text-danger" type="submit" title="Sil"><i class="bi bi-trash3"></i></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
