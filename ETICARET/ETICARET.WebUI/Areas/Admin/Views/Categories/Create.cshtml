@model CategoryFormModel
@{
    ViewData["Title"] = "Yeni Kategori";
}

<div class="admin-page-head">
    <div>
        <h1>Yeni Kategori</h1>
        <p>Kategori adı mağazada menüde ve adres çubuğunda görünür.</p>
    </div>
    <a class="btn btn-light" asp-action="Index"><i class="bi bi-arrow-left me-1"></i> Kategoriler</a>
</div>

<div class="panel" style="max-width: 560px">
    <div class="panel-body">
        <form asp-action="Create" method="post">
            <div class="mb-4">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" autofocus />
                <span asp-validation-for="Name"></span>
            </div>
            <button class="btn btn-primary" type="submit"><i class="bi bi-check2 me-1"></i> Kaydet</button>
            <a class="btn btn-light" asp-action="Index">Vazgeç</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
